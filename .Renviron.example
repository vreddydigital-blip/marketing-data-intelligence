# Copy this file to .Renviron and adjust values. Never commit real secrets.
# Maximum upload size in MB (default 50)
MDI_MAX_UPLOAD_MB=50

# Directory for temporary uploads, reports, and the SQLite database
MDI_DATA_DIR=data

# Application log level: DEBUG, INFO, WARN, ERROR (default INFO)
MDI_LOG_LEVEL=INFO

# shinyapps.io publishing account (used by deploy.R). Get values from
# https://www.shinyapps.io/admin/#/Tokens after creating your free account.
# SHINYAPPS_NAME=my-account-name
# SHINYAPPS_TOKEN=xxxxx
# SHINYAPPS_SECRET=xxxxx
